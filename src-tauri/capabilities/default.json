{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main and sidebar windows",
  "windows": [
    "main",
    "sidebar"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:window:allow-destroy",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-ask"
  ]
}
