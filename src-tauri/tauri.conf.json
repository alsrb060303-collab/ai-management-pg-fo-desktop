{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-management",
  "version": "0.1.0",
  "identifier": "io.github.alsrb060303collab.aimanagement",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "sidebar",
        "title": "AI Management",
        "width": 360,
        "height": 760,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "main",
        "title": "AI Management",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "create": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
