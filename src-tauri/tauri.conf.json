{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Encela",
  "version": "0.1.46",
  "identifier": "io.github.alsrb060303collab.aimanagement",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "sidebar",
        "title": "Encela",
        "width": 360,
        "height": 760,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "main",
        "title": "Encela",
        "width": 1400,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 620,
        "center": true,
        "create": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyREY2NjZFQkUzMEI0RkIKUldUN3REQytibWJmNHRqMXBMSDc5K0QrOHk4ekpuaEFoS1lXdFBEWjJXWGZHb2xVdWZ2SXlEc2QK",
      "endpoints": [
        "https://github.com/oceanstarlight/ai-management-pg-fo-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
